# ============================================================================
# Production-Grade Docker Ignore File
# ============================================================================
# This file reduces Docker build context size for faster builds and smaller
# images. Patterns are organized by category for maintainability.
# ============================================================================

# Python runtime files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
*pycache
*.pyi

# Virtual environments
*venv
.venv/
venv/
ENV/
env/

# Testing
.pytest_cache/
.coverage
coverage.xml
htmlcov/
*.cover
.hypothesis/
.tox/
.nox/
test-local-scripts/
tests/
conftest.py
pytest.ini

# IDEs and editors
*.idea
*.vscode
*.pycharm
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-*

# Environment files (exclude all except potential example)
.env
.env.*
.env.development
.env.local
.env.production
!.env.example

# Documentation
docs/
*.md
!README.md

# Git
.git/
.gitignore
.gitattributes
.gitmodules

# CI/CD
.github/
.gitlab-ci.yml
.circleci/
.azure-pipelines/
azure-pipelines*.yml

# Local development
testing_local/
test-local-scripts/
docker/
docker-compose*.yml
Dockerfile.local

# Cache directories
cache/
.cache/
.uv_cache/
.ruff_cache/
.mypy_cache/
.pytype/

# Requirements (no longer needed with pyproject.toml)
requirements*.txt

# Development tools
.pre-commit-config.yaml
Makefile
.editorconfig
.pylintrc
.flake8
ruff.toml
pyproject.toml.bak

# Logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp

# Kubernetes/Helm (for production builds)
charts/
*.yaml
!pyproject.toml

# Build artifacts
*.whl
*.tar.gz
*.zip

# Jupyter notebooks (if any)
*.ipynb
.ipynb_checkpoints/

# Node modules (if any frontend assets)
node_modules/
package-lock.json
yarn.lock

# Secrets and credentials (never include in build context)
*.pem
*.key
*.crt
credentials/
secrets/

# Migration scripts (if already applied)
# Uncomment if migrations are pre-applied:
# migrations/

# Deprecated code (not actively maintained)
/deprecated/
