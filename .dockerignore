# ============================================================================
# Production-Grade Docker Ignore File
# ============================================================================

# Python runtime files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
*pycache

# Virtual environments
*venv
.venv/
venv/
ENV/
env/

# Testing
.pytest_cache/
.coverage
htmlcov/
*.cover
.hypothesis/
.tox/
test-local-scripts/
tests/

# IDEs
*.idea
*.vscode
*.pycharm
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Environment files (exclude all except potential example)
.env
.env.*
.env.development
.env.local
.env.production
!.env.example

# Documentation
docs/
*.md
!README.md

# Git
.git/
.gitignore
.gitattributes

# CI/CD
.github/
.gitlab-ci.yml
.circleci/

# Local testing
testing_local
test-local-scripts/

# Cache directories
cache/
.cache/
.uv_cache/

# Requirements (no longer needed with pyproject.toml)
requirements.txt
requirements_dev.txt

# Development tools
.pre-commit-config.yaml
Makefile

# Logs and temporary files
*.log
logs/
tmp/
temp/

# Kubernetes/Helm
charts/
*.yaml
!pyproject.toml

# Migration scripts (if already applied)
# Uncomment if migrations are pre-applied:
# migrations/
