            },
            {
              "title": "login",
              "description": "Link your CopilotGTM account"
            },
            {
              "title": "test1",
              "description": "Test command 1"
            },
            {
              "title": "test2",
              "description": "Test command 2"
            },
            {
              "title": "test3",
              "description": "Test command 3"
            }
          ]
        },
        {
