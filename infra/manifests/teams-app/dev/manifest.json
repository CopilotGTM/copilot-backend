{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.2.5",
  "id": "a726a205-7f3c-4116-8dcb-2e69ab2ffa8a",
  "developer": {
    "name": "CopilotGTM",
    "websiteUrl": "https://www.copilotgtm.com",
    "privacyUrl": "https://www.copilotgtm.com/privacy",
    "termsOfUseUrl": "https://www.copilotgtm.com/terms"
  },
  "name": {
    "short": "Kai - DEV",
    "full": "Kai by CopilotGTM - AI Sales Assistant (Development)"
  },
  "description": {
    "short": "AI sales assistant for deals, meetings, and team knowledge",
    "full": "Kai is the AI sales assistant from CopilotGTM. It brings deal context, meeting notes, CRM insights, and team knowledge into Microsoft Teams so sales teams can prepare for meetings, follow up faster, and keep deal conversations connected to the work happening across Teams."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#5558AF",
  "bots": [
    {
      "botId": "a726a205-7f3c-4116-8dcb-2e69ab2ffa8a",
      "scopes": ["personal", "groupChat"],
      "supportsFiles": true,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": ["personal"],
          "commands": [
            {
              "title": "help",
              "description": "Get help using Kai"
            },
            {
              "title": "login",
              "description": "Link your CopilotGTM account"
            }
          ]
        },
        {
          "scopes": ["groupChat"],
          "commands": [
            {
              "title": "help",
              "description": "Get help using Kai"
            }
          ]
        }
      ]
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "publisherDocsUrl": "https://www.copilotgtm.com",
  "defaultInstallScope": "personal",
  "validDomains": [
    "www.copilotgtm.com",
    "*.copilotgtm.com",
    "*.ngrok-free.dev"
  ]
}
